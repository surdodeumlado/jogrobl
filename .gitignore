# Project place file — built by `rojo build`, never edited by hand
/jogrobl.rbxlx
/*.rbxl

# Roblox Studio lock files
/*.rbxlx.lock
/*.rbxl.lock

# Generated by `rojo sourcemap`, consumed by luau-lsp
sourcemap.json

# The Roblox API definitions luau-lsp needs. Fetched, not authored — see the
# URL in CLAUDE.md. Nearly a megabyte of generated types that changes with
# every Roblox release, so it belongs in nobody's diff.
/globalTypes.d.luau

# Wally-installed packages (regenerated by `wally install`)
/Packages/*
/ServerPackages/*
!/Packages/.gitkeep
!/ServerPackages/.gitkeep

# Editor and OS noise
.DS_Store
Thumbs.db
/.vscode/
